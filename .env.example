# Copy this file to .env and edit the values.

# Server
PORT=3000
NODE_ENV=development

# Session — set a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Site URL used to build absolute canonical / OG links
SITE_URL=http://localhost:3000

# Default admin (only used the very first time the DB is seeded)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zexmarketing.com
ADMIN_PASSWORD=ChangeMe!2026
